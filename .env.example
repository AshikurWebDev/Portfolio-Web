# Base URL of the ASP.NET Core API. Leave empty to use the static content in src/content.
# Development with the API running (see api/README.md): use the Vite dev server's own
# origin; vite.config.ts proxies /api to http://localhost:5180.
#   VITE_API_URL=http://localhost:5173
# Production example:
#   VITE_API_URL=https://api.example.com
VITE_API_URL=

# Live site origin, no trailing slash, e.g. https://ashikur.dev
# Used for canonical links, og:url/og:image, JSON-LD and sitemap.xml. Empty skips those.
VITE_SITE_URL=

# Google OAuth client id for "Sign in with Google" in the blog admin (/admin).
# Create it in Google Cloud Console; the same id goes in the API's Authentication:Google:ClientId.
VITE_GOOGLE_CLIENT_ID=
